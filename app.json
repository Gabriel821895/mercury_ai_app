{
  "expo": {
    "name": "Mercury AI",
    "slug": "venda-bot-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-primary.png",
    "splash": {
      "image": "./assets/logo-primary.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mercuryai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-primary.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/logo-primary.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/logo-primary.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
